{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    },
    "ChangedFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "oldPath": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ChangeStatus"
        },
        "additions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "deletions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "binary": {
          "type": "boolean"
        },
        "blob": {
          "type": "string"
        },
        "oldBlob": {
          "type": "string"
        },
        "generated": {
          "type": "boolean"
        },
        "submodule": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "path",
        "status",
        "additions",
        "deletions",
        "binary",
        "blob",
        "oldBlob",
        "generated"
      ]
    },
    "ChangeStatus": {
      "type": "string",
      "enum": [
        "A",
        "M",
        "D",
        "R",
        "C",
        "T",
        "U"
      ]
    },
    "ClearThreadsQuery": {
      "type": "object",
      "properties": {
        "stale": {
          "type": "string",
          "const": "1"
        }
      }
    },
    "CommentAnchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "line"
            },
            "path": {
              "type": "string"
            },
            "side": {
              "$ref": "#/$defs/Side"
            },
            "startLine": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "endLine": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "quoted": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "side",
            "startLine",
            "endLine",
            "quoted"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "CommentMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "body",
        "createdAt",
        "updatedAt"
      ]
    },
    "CommentThread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/CommentAnchor"
        },
        "messages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommentMessage"
          }
        },
        "resolved": {
          "type": "boolean"
        },
        "resolvedAt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stale": {
          "type": "boolean"
        },
        "staleFromLine": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "anchor",
        "messages",
        "resolved",
        "stale"
      ]
    },
    "CommitInfo": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "sha",
        "short",
        "message"
      ]
    },
    "ComparisonBase": {
      "type": "string",
      "enum": [
        "direct",
        "merge-base"
      ]
    },
    "ConfigUpdate": {
      "type": "object",
      "properties": {
        "autoViewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "followRefs": {
          "$ref": "#/$defs/FollowRefs"
        },
        "lineWrap": {
          "type": "boolean"
        }
      }
    },
    "EnterRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "working"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pr"
            },
            "pr": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "revspec"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range-diff"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "args"
          ]
        }
      ]
    },
    "FileAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "file"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ]
    },
    "FileQuery": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rev": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "path",
        "rev"
      ]
    },
    "FileResponse": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "contents": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "contents",
        "binary"
      ]
    },
    "FollowRefs": {
      "type": "string",
      "enum": [
        "on",
        "auto",
        "off"
      ]
    },
    "GithubExportRequest": {
      "type": "object",
      "properties": {
        "threadIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GithubExportResponse": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "posted": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "updated": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "review": {
          "type": "string",
          "enum": [
            "created",
            "existing"
          ]
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "url",
        "posted",
        "updated",
        "review",
        "skipped"
      ]
    },
    "GithubMetadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "pullRequest": {
          "anyOf": [
            {
              "$ref": "#/$defs/GithubPullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "repository",
        "repositoryUrl",
        "pullRequest",
        "reason"
      ]
    },
    "GithubPullRequest": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED",
            "MERGED"
          ]
        },
        "isDraft": {
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "number",
        "url",
        "title",
        "state",
        "isDraft"
      ]
    },
    "ImageQuery": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rev": {
          "$ref": "#/$defs/Side"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "rev",
        "key"
      ]
    },
    "Interdiff": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/RangeEnds"
        },
        "to": {
          "$ref": "#/$defs/RangeEnds"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RangePair"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "from",
        "to",
        "pairs",
        "conflicts"
      ]
    },
    "Iteration": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "oldSha": {
          "type": "string"
        },
        "newSha": {
          "type": "string"
        },
        "recordedAt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "n",
        "oldSha",
        "newSha",
        "recordedAt"
      ]
    },
    "LanguageId": {
      "type": "string",
      "enum": [
        "astro",
        "c",
        "cpp",
        "csharp",
        "css",
        "go",
        "haskell",
        "html",
        "java",
        "javascript",
        "javascriptreact",
        "json",
        "jsonc",
        "lua",
        "nix",
        "ocaml",
        "php",
        "python",
        "ruby",
        "rust",
        "shellscript",
        "swift",
        "terraform",
        "toml",
        "typescript",
        "typescriptreact",
        "vue",
        "yaml",
        "zig"
      ]
    },
    "LastCommitsPreview": {
      "type": "object",
      "properties": {
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "old",
        "new"
      ]
    },
    "LastCommitsQuery": {
      "type": "object",
      "properties": {
        "oldOffset": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "newOffset": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "oldOffset",
        "newOffset"
      ]
    },
    "LineAnchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "line"
        },
        "path": {
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "startLine": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "quoted": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "side",
        "startLine",
        "endLine",
        "quoted"
      ]
    },
    "Live": {
      "type": "string",
      "enum": [
        "worktree",
        "refs",
        "none"
      ]
    },
    "LspFeature": {
      "type": "string",
      "enum": [
        "definition",
        "typeDefinition",
        "hover",
        "references",
        "documentSymbol",
        "workspaceSymbol",
        "documentHighlight"
      ]
    },
    "LspHoverResponse": {
      "type": "object",
      "properties": {
        "contents": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "col": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "endLine": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "endCol": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "line",
            "col",
            "endLine",
            "endCol"
          ]
        },
        "inconclusive": {
          "type": "string"
        }
      },
      "required": [
        "contents"
      ]
    },
    "LspLocation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "external": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "path",
        "line",
        "col",
        "text"
      ]
    },
    "LspLocationsResponse": {
      "type": "object",
      "properties": {
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LspLocation"
          }
        },
        "inconclusive": {
          "type": "string"
        }
      },
      "required": [
        "locations"
      ]
    },
    "LspLogCounts": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seq",
        "errors",
        "warnings"
      ]
    },
    "LspLogEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "time": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "source": {
          "$ref": "#/$defs/LspLogSource"
        },
        "level": {
          "$ref": "#/$defs/LspLogLevel"
        },
        "message": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "time",
        "source",
        "level",
        "message",
        "count"
      ]
    },
    "LspLogLevel": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info",
        "log"
      ]
    },
    "LspLogQuery": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "server"
      ]
    },
    "LspLogResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LspLogEntry"
          }
        }
      },
      "required": [
        "entries"
      ]
    },
    "LspLogSource": {
      "type": "string",
      "enum": [
        "message",
        "log",
        "stderr"
      ]
    },
    "LspMissing": {
      "type": "object",
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "tried": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "tried"
      ]
    },
    "LspNotice": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message"
      ]
    },
    "LspOccurrence": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endCol": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "read",
            "write"
          ]
        }
      },
      "required": [
        "line",
        "col",
        "endLine",
        "endCol",
        "kind"
      ]
    },
    "LspOccurrencesResponse": {
      "type": "object",
      "properties": {
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LspOccurrence"
          }
        }
      },
      "required": [
        "occurrences"
      ]
    },
    "LspPosition": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "line",
        "col"
      ]
    },
    "LspProcessStatus": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/LspState"
        },
        "message": {
          "type": "string"
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notice": {
          "$ref": "#/$defs/LspNotice"
        },
        "log": {
          "$ref": "#/$defs/LspLogCounts"
        }
      },
      "required": [
        "name",
        "command",
        "state",
        "log"
      ]
    },
    "LspProjects": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label",
        "paths"
      ]
    },
    "LspServerStatus": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/LspState"
        },
        "message": {
          "type": "string"
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notice": {
          "$ref": "#/$defs/LspNotice"
        },
        "log": {
          "$ref": "#/$defs/LspLogCounts"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageId"
          }
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageId"
          }
        },
        "supports": {
          "type": "array",
          "items": {
