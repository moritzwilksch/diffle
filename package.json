{
  "name": "@moritzwilksch/diffle",
  "version": "0.3.3",
  "private": true,
  "description": "Local git diff reviewer in the browser with line comments exported as agent prompts",
  "keywords": [
    "agent",
    "cli",
    "code-review",
    "diff",
    "git"
  ],
  "homepage": "https://diffle.app",
  "bugs": {
    "url": "https://github.com/moritzwilksch/diffle/issues"
  },
  "license": "Apache-2.0",
  "author": "Moritz Wilksch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzwilksch/diffle.git"
  },
  "type": "module",
  "scripts": {
    "fixture": "tsx scripts/fixture-repo.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshot": "tsx scripts/screenshot.ts",
    "videos": "tsx scripts/record-videos.ts",
    "test:e2e:report": "playwright show-report playwright-report",
    "snapshot-report": "tsx scripts/snapshot-report.ts",
    "quality-gate": "tsx scripts/quality-gate.ts",
    "check-version": "tsx scripts/check-version.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "3.1.1",
    "@pierre/diffs": "1.6.1",
    "@pierre/trees": "1.0.0-beta.6",
    "commander": "^15.0.0",
    "lucide-react": "^1.57.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "jsdom": "^30.1.2",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^7.0",
    "vite": "^8.3.4",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=24.14"
  }
}
