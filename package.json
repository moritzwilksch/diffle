{
  "name": "@moritzwilksch/diffle",
  "version": "0.3.1",
  "private": true,
  "description": "Local git diff reviewer in the browser with line comments exported as agent prompts",
  "keywords": [
    "agent",
    "cli",
    "code-review",
    "diff",
    "git"
  ],
  "homepage": "https://diffle.app",
  "bugs": {
    "url": "https://github.com/moritzwilksch/diffle/issues"
  },
  "license": "Apache-2.0",
  "author": "Moritz Wilksch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzwilksch/diffle.git"
  },
  "type": "module",
  "scripts": {
    "fixture": "tsx scripts/fixture-repo.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshot": "tsx scripts/screenshot.ts",
    "videos": "tsx scripts/record-videos.ts",
    "test:e2e:report": "playwright show-report playwright-report",
    "snapshot-report": "tsx scripts/snapshot-report.ts",
    "quality-gate": "tsx scripts/quality-gate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "commander": "^15.0.0",
    "lucide-react": "^1.39.0",
    "picomatch": "^4.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5.9",
    "vite": "^8.2.2",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=24.14"
  }
}
